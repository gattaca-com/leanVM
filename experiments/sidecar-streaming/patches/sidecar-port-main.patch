+//! Write valid leanXMSS signatures in the record format of `testdata/signatures-24000.bin`:
+//! gen_signatures <count> <file>
+//!
+//! One key signs `count` distinct messages, each at its own leaf index. Every record is
+//! `pubkey | message | signature`. The claims differ from those of the test data, whose signers differ.
+
+use leanvm::lean_xmss::{self, LeafIndex, MESSAGE_LEN, SECRET_KEY_LEN};
+use std::io::Write;
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let [_, count, path] = args.as_slice() else {
+        eprintln!("usage: gen_signatures <count> <file>");
+        std::process::exit(2);
+    };
+    let count: usize = count.parse().expect("count");
+    let (secret_key, pub_key) = lean_xmss::key_gen(&[9; SECRET_KEY_LEN]);
+    let secret_key = &secret_key;
+    let workers = std::thread::available_parallelism().map_or(1, usize::from);
+    let per_worker = count.div_ceil(workers).max(1);
+    let parts: Vec<Vec<u8>> = std::thread::scope(|scope| {
+        let handles: Vec<_> = (0..count.div_ceil(per_worker))
+            .map(|worker| {
+                scope.spawn(move || {
+                    let mut out = Vec::new();
+                    for index in worker * per_worker..((worker + 1) * per_worker).min(count) {
+                        let mut message = [0u8; MESSAGE_LEN];
+                        message[..8].copy_from_slice(&(index as u64 + (1 << 40)).to_le_bytes());
+                        let signature = lean_xmss::sign(secret_key, &message, index as LeafIndex);
+                        out.extend(pub_key.to_bytes());
+                        out.extend(message);
+                        out.extend(signature.to_bytes());
+                    }
+                    out
+                })
+            })
+            .collect();
+        handles.into_iter().map(|handle| handle.join().unwrap()).collect()
+    });
+    let mut file = std::fs::File::create(path).expect("create file");
+    for part in parts {
+        file.write_all(&part).unwrap();
+    }
+}

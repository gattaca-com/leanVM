diff --git a/crates/leanvm_sidecar_client/examples/jumps.rs b/crates/leanvm_sidecar_client/examples/jumps.rs
index 121ed627e..b5e8f12cf 100644
--- a/crates/leanvm_sidecar_client/examples/jumps.rs
+++ b/crates/leanvm_sidecar_client/examples/jumps.rs
@@ -238,6 +238,66 @@ impl Bench {
         }
     }
 
+    /// Sizes above a leaf of 1500, for about 1700 attesters per subnet. Run alone (`big`), appending to the CSV.
+    /// AGGREGATE 1500 to 2048 at step 32, refined to step 4 around jumps; EXTEND of a kept 1500 with 1 to 548 new
+    /// (kept proof at the EXTEND's rate); RECURSE of 16 children of 1700 signatures (rate 2) at rate 1.
+    /// The 16 x 1700 claims come from file `a` (24000 records) and the first 3200 of file `b`, whose claims do not
+    /// overlap `a`'s, so no two children share a claim.
+    fn big(&mut self) {
+        for rate in [1, 2] {
+            let mut sizes: Vec<usize> = (1500..2048).step_by(32).collect();
+            sizes.push(2048);
+            let mut series = Vec::new();
+            for n in sizes {
+                if let Some(ms) = self.aggregate_at(n, rate) {
+                    series.push((n, ms));
+                }
+            }
+            // Step 4 inside the intervals that jump.
+            let mut slopes: Vec<(f64, usize)> = series
+                .windows(2)
+                .enumerate()
+                .map(|(i, w)| ((w[1].1 - w[0].1) / (w[1].0 - w[0].0) as f64, i))
+                .collect();
+            let mut sorted: Vec<f64> = slopes.iter().map(|s| s.0).collect();
+            sorted.sort_by(f64::total_cmp);
+            let median = sorted[sorted.len() / 2].max(0.01);
+            slopes.sort_by(|x, y| y.0.total_cmp(&x.0));
+            for (slope, i) in slopes.into_iter().take(2) {
+                if slope <= 3.0 * median {
+                    break;
+                }
+                let (lo, hi) = (series[i].0, series[i + 1].0);
+                println!("refine ({lo}, {hi}]: {slope:.2} ms per signature, median {median:.2}");
+                for n in (lo + 4..hi).step_by(4) {
+                    self.aggregate_at(n, rate);
+                }
+            }
+        }
+        for rate in [1, 2] {
+            let mut series = Vec::new();

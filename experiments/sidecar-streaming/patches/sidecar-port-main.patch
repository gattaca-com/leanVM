diff --git a/bins/leanvm-sidecar/e2e.sh b/bins/leanvm-sidecar/e2e.sh
new file mode 100755
index 000000000..42465753a
--- /dev/null
+++ b/bins/leanvm-sidecar/e2e.sh
@@ -0,0 +1,78 @@
+#!/usr/bin/env bash
+# End-to-end run of leanvm-sidecar through one language's client:
+#
+#   e2e.sh <rust|go|java|ts> <threads> [aggregate-log-inv-rate=2] [recurse-log-inv-rate=1]
+#
+# Starts the server with <threads> prover threads, aggregates 16 batches of 1500 leanXMSS
+# signatures one after the other, then recurses the 16 proofs into one. Each step prints its
+# request, its response and the time it took, as the client sees it.
+#
+# The signatures are testdata/signatures-24000.bin: 24000 signers, each signing one of 4 messages;
+# examples/gen_signatures.rs regenerates the file if it is missing. Java uses the JDK on PATH, or
+# else the eclipse-temurin:21-jdk container through docker. TypeScript needs node, npm and a C
+# compiler (clients/typescript/build.sh).
+set -euo pipefail
+
+usage() {
+    sed -n '2,4p' "$0" >&2
+    exit 2
+}
+[[ $# -ge 2 && $# -le 4 ]] || usage
+lang=$1
+threads=$2
+aggregate_rate=${3:-2}
+recurse_rate=${4:-1}
+[[ $lang == rust || $lang == go || $lang == java || $lang == ts ]] || usage
+
+here=$(cd "$(dirname "$0")" && pwd)
+root=$(cd "$here/../.." && pwd)
+cd "$root"
+work=$root/target/leanvm-sidecar
+signatures=$here/testdata/signatures-24000.bin
+channel=/dev/shm/leanvm-e2e-$$
+mkdir -p "$work"
+
+cargo build --release -p leanvm-sidecar -p leanvm_sidecar_client --examples --bins
+if [[ ! -f $signatures ]]; then
+    echo "generating 24000 signatures into $signatures"
+    mkdir -p "$here/testdata"
+    target/release/examples/gen_signatures 24000 "$signatures.tmp"
+    mv "$signatures.tmp" "$signatures"
+fi
+
+# Build the runner before the server starts, so the timings hold no compilation.
+case $lang in
+rust) runner=(target/release/examples/e2e) ;;
+go)
+    (cd "$here/clients/go" && go build -o "$work/e2e-go" ./e2e)
+    runner=("$work/e2e-go")
+    ;;
+java)
+    if command -v javac >/dev/null; then
+        javac -d "$work/java" "$here"/clients/java/leanvmsidecar/*.java
+        runner=(java -cp "$work/java" leanvmsidecar.E2e)
+    else
+        jdk=(docker run --rm -u "$(id -u):$(id -g)" -v /dev/shm:/dev/shm -v "$root:$root" -w "$root" eclipse-temurin:21-jdk)
+        "${jdk[@]}" javac -d "$work/java" "$here"/clients/java/leanvmsidecar/Client.java "$here"/clients/java/leanvmsidecar/E2e.java
+        runner=("${jdk[@]}" java -cp "$work/java" leanvmsidecar.E2e)
+    fi
+    ;;
+ts)
+    "$here/clients/typescript/build.sh"
+    runner=(node "$here/clients/typescript/dist/e2e.js")
+    ;;
+esac
+
+rm -f "$channel"
+target/release/leanvm-sidecar --path "$channel" --threads "$threads" --arena-mib 256 &
+server=$!
+trap 'kill $server 2>/dev/null || true; wait $server 2>/dev/null || true; rm -f "$channel"' EXIT
+
+# The server creates the channel once the prover is warm.
+until [[ -f $channel ]]; do
+    kill -0 $server 2>/dev/null || { echo "leanvm-sidecar exited" >&2; exit 1; }
+    sleep 0.1
+done
+
+echo "client $lang, $threads threads, aggregate rate $aggregate_rate, recurse rate $recurse_rate"
+"${runner[@]}" "$channel" "$signatures" "$aggregate_rate" "$recurse_rate"
diff --git a/bins/leanvm-sidecar/examples/gen_signatures.rs b/bins/leanvm-sidecar/examples/gen_signatures.rs
new file mode 100644
index 000000000..c2c4f743e
--- /dev/null
+++ b/bins/leanvm-sidecar/examples/gen_signatures.rs
@@ -0,0 +1,48 @@
+//! Write the valid leanXMSS signatures `e2e.sh` reads: gen_signatures <count> <file>
+//!
+//! The file is `count` records of `pubkey | message | signature`, the triple of an `AGGREGATE`
+//! payload. Every record has its own signer; signer `i` signs message `i mod MESSAGES`, whose
+//! bytes all equal that number. Signers are mock keys, real at the one leaf index they sign at,
+//! so their signatures verify like a full key's; the secret keys are derived from the record index
+//! and worth nothing.
+
+use signatures::lean_xmss::{LeafIndex, MESSAGE_LEN, PUB_KEY_SIZE, SIG_SIZE, mock};
+use std::io::Write;
+
+const MESSAGES: usize = 4;
+const LEAF_INDEX: LeafIndex = 0;
+const RECORD: usize = PUB_KEY_SIZE + MESSAGE_LEN + SIG_SIZE;
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let (count, path) = match args.as_slice() {
+        [_, count, path] => (count.parse::<usize>().expect("count"), path),
+        _ => {
+            eprintln!("usage: gen_signatures <count> <file>");
+            std::process::exit(2);
+        }
+    };
+    let mut records = vec![0u8; count * RECORD];
+    let workers = std::thread::available_parallelism().map_or(1, usize::from);
+    let per_worker = count.div_ceil(workers).max(1);
+    std::thread::scope(|scope| {
+        for (worker, chunk) in records.chunks_mut(per_worker * RECORD).enumerate() {
+            scope.spawn(move || {
+                for (offset, record) in chunk.as_chunks_mut::<RECORD>().0.iter_mut().enumerate() {
+                    let index = worker * per_worker + offset;
+                    // One seed per signer, always over the one leaf: a seed backs one key only (`mock`).
+                    let mut seed = [0x5e; 32];
+                    seed[..8].copy_from_slice(&(index as u64).to_le_bytes());
+                    let (secret_key, pub_key) = mock::key_gen_from_seed(seed, LEAF_INDEX, LEAF_INDEX);
+                    let message = [(index % MESSAGES) as u8; MESSAGE_LEN];
+                    let signature = mock::sign(&secret_key, &message, LEAF_INDEX).unwrap();
+                    let (head, tail) = record.split_at_mut(PUB_KEY_SIZE + MESSAGE_LEN);
+                    head[..PUB_KEY_SIZE].copy_from_slice(&pub_key.to_bytes());
+                    head[PUB_KEY_SIZE..].copy_from_slice(&message);
+                    tail.copy_from_slice(&signature.to_bytes());
+                }
+            });
+        }
+    });
+    std::fs::File::create(path).and_then(|mut file| file.write_all(&records)).expect("write");
+}
diff --git a/bins/leanvm-sidecar/src/main.rs b/bins/leanvm-sidecar/src/main.rs
new file mode 100644
index 000000000..2002a42c6
--- /dev/null
+++ b/bins/leanvm-sidecar/src/main.rs
@@ -0,0 +1,272 @@
+//! leanVM as a service over shared memory: leanXMSS aggregation, recursion and verification for one
+//! client process, in any language. `PROTOCOL.md` specifies the channel file and the encodings.
+
+#[global_allocator]
+static ALLOCATOR: bench::Jemalloc = bench::Jemalloc;
+
+use clap::Parser;
+use shm::{Channel, Ring};
+use std::path::PathBuf;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::time::Duration;
+use wire::{Request, Response, ST_OK, ST_RESP_TOO_SMALL};
+
+mod serve;
+mod shm;
+mod warm;
+mod wire;
+
+/// Wait between polls of an empty request ring. Far below the cost of any request.
+const IDLE_POLL: Duration = Duration::from_micros(100);
+
+#[derive(Parser)]
+struct Args {
+    /// The channel file, created if missing. Put it on tmpfs (/dev/shm).
+    #[arg(long)]
+    path: PathBuf,
+
+    /// Prover performance-worker count (1 = sequential). Default: the pool's own, one per physical core.
+    #[arg(long, value_parser = clap::builder::RangedU64ValueParser::<usize>::new().range(1..))]
+    threads: Option<usize>,
+
+    /// Arena size in MiB. One request's payload and response regions both have to fit.
+    #[arg(long, default_value_t = 64, value_parser = clap::builder::RangedU64ValueParser::<usize>::new().range(1..))]
+    arena_mib: usize,
+
+    /// Slots in each ring; a power of two.
+    #[arg(long, default_value_t = 64)]
+    ring_cap: u32,
+
+    /// Signatures in the discarded warm-up proofs run before serving; 0 skips them. Set it to the
+    /// largest batch expected: a larger proof than any before it still pays first-touch page faults.
+    #[arg(long, default_value_t = 1500)]
+    warmup_signatures: usize,
+
+    /// WHIR inverse-rate logarithms to warm up, comma separated: the rates requests will ask for.
+    #[arg(
+        long,
+        value_delimiter = ',',
+        default_value = "1,2",
+        value_parser = clap::builder::RangedU64ValueParser::<usize>::new()
+            .range(leanvm::MIN_LOG_INV_RATE as u64..=leanvm::MAX_LOG_INV_RATE as u64)
+    )]
+    warmup_rates: Vec<usize>,
+
+    /// Print a timing tree per request. Use RUST_LOG to adjust verbosity.
+    #[arg(long)]
+    tracing: bool,
+}
+
+/// Serve requests one at a time until `stop`: `aggregate` must not run twice at once in a process.
+fn run(chan: &Channel, stop: &AtomicBool) {
+    while !stop.load(Ordering::Relaxed) {
+        let Some(msg) = chan.pop(Ring::Request) else {
+            std::thread::sleep(IDLE_POLL);
+            continue;
+        };
+        let request = Request::decode(&msg);
+        let _span = tracing::info_span!("request", id = request.id, op = request.op).entered();
+
+        // Without a response region there is nowhere to put even an error's text.
+        let writable = chan.in_arena(request.resp_off, request.resp_cap);
+        let result = match chan.read(request.req_off, request.req_len) {
+            Some(payload) if writable => serve::handle(&request, &payload),
+            _ => Err(serve::Failure::bad_request("region outside the arena")),
+        };
+        let (status, detail, resp_len, body) = match result {
+            Ok(body) if body.len() as u64 > request.resp_cap => (ST_RESP_TOO_SMALL, 0, body.len() as u64, Vec::new()),
+            Ok(body) => (ST_OK, 0, body.len() as u64, body),
+            Err(failure) => {
+                let mut text = failure.text.into_bytes();
+                text.truncate(if writable { request.resp_cap as usize } else { 0 });
+                (failure.status, failure.detail, text.len() as u64, text)
+            }
+        };
+        chan.write(request.resp_off, &body);
+        let response = Response {
+            id: request.id,
+            status,
+            detail,
+            resp_len,
+        };
+        chan.push(Ring::Response, &response.encode());
+    }
+}
+
+fn main() {
+    let args = Args::parse();
+    if let Some(threads) = args.threads {
+        // SAFETY: no other thread exists yet. The pool reads this once, in `setup`.
+        unsafe { std::env::set_var("LEANVM_NUM_THREADS", threads.to_string()) };
+    }
+    if args.tracing {
+        bench::init_tracing();
+    }
+    leanvm::setup();
+    if args.warmup_signatures > 0 {
+        eprintln!("warming up...");
+        let started = std::time::Instant::now();
+        let signers = args.threads.or(std::thread::available_parallelism().ok().map(usize::from)).unwrap_or(1);
+        let _quiet = bench::suppress_tracing();
+        warm::warm_up(args.warmup_signatures, &args.warmup_rates, signers);
+        eprintln!("warmed up in {:.1} s", started.elapsed().as_secs_f64());
+    }
+    let chan = match Channel::create(&args.path, args.ring_cap, args.arena_mib << 20) {
+        Ok(chan) => chan,
+        Err(error) => {
+            eprintln!("{}: {error}", args.path.display());
+            std::process::exit(1);
+        }
+    };
+    eprintln!("serving {}", args.path.display());
+    run(&chan, &AtomicBool::new(false));
+}
+
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use leanvm::lean_xmss::{self, LeanXmssPublicKey, LeanXmssSignature, Message};
+    use leanvm_sidecar_client::Client;
+    use wire::*;
+
+    const RING_CAP: u32 = 4;
+    const ARENA_LEN: usize = 32 << 20;
+    const LOG_INV_RATE: u32 = 2;
+    const RESP_CAP: usize = 4 << 20;
+
+    struct StopOnDrop<'a>(&'a AtomicBool);
+
+    impl Drop for StopOnDrop<'_> {
+        fn drop(&mut self) {
+            self.0.store(true, Ordering::Relaxed);
+        }
+    }
+
+    fn recv(client: &mut Client) -> leanvm_sidecar_client::Response {
+        loop {
+            match client.try_recv() {
+                Some(response) => return response,
+                None => std::thread::sleep(Duration::from_millis(1)),
+            }
+        }
+    }
+
+    /// The response's status, detail and body.
+    fn call(client: &mut Client, op: u32, flags: u32, payload: &[u8]) -> (u32, u32, Vec<u8>) {
+        let id = client.send(op, flags, LOG_INV_RATE, payload, RESP_CAP).unwrap();
+        let response = recv(client);
+        assert_eq!(response.id, id);
+        (response.status, response.detail, response.body)
+    }
+
+    /// A `proof | claims` body.
+    fn proved(status: u32, body: &[u8]) -> (Vec<u8>, leanvm::EthereumClaims) {
+        assert_eq!(status, ST_OK, "{}", String::from_utf8_lossy(body));
+        let mut reader = Reader(body);
+        let proof = reader.proof().unwrap().to_vec();
+        let claims = reader.claims().unwrap();
+        reader.end().unwrap();
+        (proof, claims)
+    }
+
+    fn signatures(triples: &[(LeanXmssPublicKey, Message, LeanXmssSignature)]) -> Vec<u8> {
+        let mut out = (triples.len() as u32).to_le_bytes().to_vec();
+        for (pub_key, message, signature) in triples {
+            out.extend(pub_key.to_bytes());
+            out.extend(message);
+            out.extend(signature.to_bytes());
+        }
+        out
+    }
+
+    fn proof_with_claims(proof: &[u8], claims: &leanvm::EthereumClaims) -> Vec<u8> {
+        let mut out = Vec::new();
+        put_claims(&mut out, claims);
+        put_proof(&mut out, proof);
+        out
+    }
+
+    fn client(path: &std::path::Path) {
+        let mut client = Client::open(path).unwrap();
+        assert_eq!(client.sig_size(), lean_xmss::SIG_SIZE);
+
+        let message = [7; lean_xmss::MESSAGE_LEN];
+        let triples: Vec<_> = (0..3)
+            .map(|leaf_index| {
+                let (secret_key, pub_key) = lean_xmss::key_gen();
+                (pub_key, message, lean_xmss::sign(&secret_key, &message, leaf_index).unwrap())
+            })
+            .collect();
+
+        // Two requests in flight: answered in order, each from its own arena block.
+        let first = client.send(OP_AGGREGATE, 0, LOG_INV_RATE, &signatures(&triples[..2]), RESP_CAP).unwrap();
+        let second = client.send(OP_AGGREGATE, 0, LOG_INV_RATE, &signatures(&triples[2..]), RESP_CAP).unwrap();
+        let (left, right) = (recv(&mut client), recv(&mut client));
+        assert_eq!((left.id, right.id), (first, second));
+        let (left, left_claims) = proved(left.status, &left.body);
+        let (right, right_claims) = proved(right.status, &right.body);
+        assert_eq!((left_claims.xmss.len(), right_claims.xmss.len()), (2, 1));
+
+        let verify = proof_with_claims(&left, &left_claims);
+        assert_eq!(call(&mut client, OP_VERIFY, 0, &verify).0, ST_OK);
+        let mut fewer = left_claims.clone();
+        fewer.xmss.pop();
+        let (status, detail, _) = call(&mut client, OP_VERIFY, 0, &proof_with_claims(&left, &fewer));
+        assert_eq!((status, detail), (ST_INVALID_PROOF, 0));
+
+        let mut recurse = 2u32.to_le_bytes().to_vec();
+        recurse.extend(proof_with_claims(&left, &left_claims));
+        recurse.extend(proof_with_claims(&right, &right_claims));
+        let (status, _, body) = call(&mut client, OP_RECURSE, FLAG_VERIFY_CHILDREN, &recurse);
+        let (root, root_claims) = proved(status, &body);
+        assert_eq!(root_claims.xmss.len(), 3);
+
+        // The second child claims what the first proved: named by its index.
+        let mut swapped = 2u32.to_le_bytes().to_vec();
+        swapped.extend(proof_with_claims(&left, &left_claims));
+        swapped.extend(proof_with_claims(&right, &left_claims));
+        let (status, detail, _) = call(&mut client, OP_RECURSE, FLAG_VERIFY_CHILDREN, &swapped);
+        assert_eq!((status, detail), (ST_INVALID_PROOF, 1));
+
+        let mut retained = root_claims.clone();
+        retained.xmss.remove(1);
+        let mut narrow = proof_with_claims(&root, &root_claims);
+        put_claims(&mut narrow, &retained);
+        let (status, _, body) = call(&mut client, OP_VERIFY_NARROW, 0, &narrow);
+        let (narrowed, narrowed_claims) = proved(status, &body);
+        assert_eq!(narrowed_claims, retained);
+        let verify = proof_with_claims(&narrowed, &narrowed_claims);
+        assert_eq!(call(&mut client, OP_VERIFY, 0, &verify).0, ST_OK);
+
+        // A response region too small for the proof: the size needed comes back, with no body.
+        client.send(OP_VERIFY_NARROW, 0, LOG_INV_RATE, &narrow, 8).unwrap();
+        let response = recv(&mut client);
+        assert_eq!(response.status, ST_RESP_TOO_SMALL);
+        assert!(response.resp_len > 8 && response.body.is_empty());
+
+        assert_eq!(call(&mut client, OP_VERIFY, 0, &verify[..verify.len() - 1]).0, ST_BAD_REQUEST);
+        assert_eq!(call(&mut client, 99, 0, &[]).0, ST_BAD_REQUEST);
+        assert_eq!(client.send(OP_VERIFY, 0, 0, &[], ARENA_LEN + 1), Err(leanvm_sidecar_client::Full));
+    }
+
+    #[test]
+    fn serves_every_op() {
+        leanvm::setup();
+        let path = std::env::temp_dir().join(format!("leanvm-sidecar-test-{}", std::process::id()));
+        let chan = Channel::create(&path, RING_CAP, ARENA_LEN).unwrap();
+        // Only the arena is addressable by a request.
+        assert!(chan.read(0, 8).is_none() && !chan.in_arena(u64::MAX, 2));
+        let stop = AtomicBool::new(false);
+        std::thread::scope(|scope| {
+            let worker = scope.spawn(|| {
+                let _stop = StopOnDrop(&stop);
+                client(&path);
+            });
+            run(&chan, &stop);
+            let outcome = worker.join();
+            let _ = std::fs::remove_file(&path);
+            outcome.unwrap();
+        });
+    }
+}
diff --git a/bins/leanvm-sidecar/src/serve.rs b/bins/leanvm-sidecar/src/serve.rs
new file mode 100644
index 000000000..d06b8197c
--- /dev/null
+++ b/bins/leanvm-sidecar/src/serve.rs
@@ -0,0 +1,127 @@
+//! One request, from its payload to its response body.
+
+use crate::wire::{
+    FLAG_VERIFY_CHILDREN, OP_AGGREGATE, OP_RECURSE, OP_VERIFY, OP_VERIFY_NARROW, Reader, Request, ST_AGGREGATION_FAILED,
+    ST_BAD_REQUEST, ST_INVALID_PROOF, proved,
+};
+use leanvm::lean_xmss::{LeanXmssPublicKey, LeanXmssSignature, Message};
+use leanvm::{AggregateVerifyError, AggregationError, EthereumClaims, EthereumProof, MAX_RECURSIONS, aggregate};
+use std::error::Error;
+
+pub struct Failure {
+    pub status: u32,
+    pub detail: u32,
+    /// For a human; written to the response region, truncated to its capacity.
+    pub text: String,
+}
+
+impl Failure {
+    pub fn bad_request(text: &str) -> Self {
+        Self {
+            status: ST_BAD_REQUEST,
+            detail: 0,
+            text: text.into(),
+        }
+    }
+}
+
+fn malformed() -> Failure {
+    Failure::bad_request("malformed payload")
+}
+
+/// The `detail` of `ST_AGGREGATION_FAILED`. Part of the protocol: a variant keeps its number.
+fn aggregation_code(error: &AggregationError) -> u32 {
+    match error {
+        AggregationError::InvalidChild(_) => 1,
+        AggregationError::Empty => 2,
+        AggregationError::NotCovered => 3,
+        AggregationError::MalformedRawSignature => 4,
+        AggregationError::TooLarge => 5,
+        AggregationError::InvalidBlobSize { .. } => 6,
+        AggregationError::BlobNotCovered => 7,
+        AggregationError::BlobsUnpublished => 8,
+        AggregationError::InvalidRate { .. } => 9,
+        AggregationError::ChildOutOfRange { .. } => 10,
+        AggregationError::ProofError(_) => 11,
+    }
+}
+
+/// Child `index` of the request, decoded against `claims` and natively verified if `verify`.
+fn child(proof: &[u8], claims: EthereumClaims, index: usize, verify: bool) -> Result<EthereumProof, Failure> {
+    let invalid = |error: AggregateVerifyError| Failure {
+        status: ST_INVALID_PROOF,
+        detail: index as u32,
+        text: error.to_string(),
+    };
+    let proof = EthereumProof::from_proof_bytes(proof, claims).map_err(invalid)?;
+    if verify {
+        proof.verify().map_err(invalid)?;
+    }
+    Ok(proof)
+}
+
+fn prove(
+    children: &[EthereumProof],
+    signatures: Vec<(LeanXmssPublicKey, Message, LeanXmssSignature)>,
+    declare: Option<&EthereumClaims>,
+    log_inv_rate: usize,
+) -> Result<Vec<u8>, Failure> {
+    match aggregate(children, signatures, vec![], &[], declare, log_inv_rate) {
+        Ok(proof) => Ok(proved(&proof)),
+        Err(error) => Err(Failure {
+            status: ST_AGGREGATION_FAILED,
+            detail: aggregation_code(&error),
+            text: match error.source() {
+                Some(source) => format!("{error}: {source}"),
+                None => error.to_string(),
+            },
+        }),
+    }
+}
+
+/// The response body of `request`, whose payload is `payload`.
+pub fn handle(request: &Request, payload: &[u8]) -> Result<Vec<u8>, Failure> {
+    let log_inv_rate = request.log_inv_rate as usize;
+    let mut reader = Reader(payload);
+    match request.op {
+        OP_AGGREGATE => {
+            let signatures = reader.signatures().ok_or_else(malformed)?;
+            reader.end().ok_or_else(malformed)?;
+            prove(&[], signatures, None, log_inv_rate)
+        }
+        OP_RECURSE => {
+            let count = reader.u32().ok_or_else(malformed)? as usize;
+            if !(1..=MAX_RECURSIONS).contains(&count) {
+                return Err(Failure::bad_request("child count outside 1..=16"));
+            }
+            let mut encoded = Vec::with_capacity(count);
+            for _ in 0..count {
+                let claims = reader.claims().ok_or_else(malformed)?;
+                encoded.push((claims, reader.proof().ok_or_else(malformed)?));
+            }
+            reader.end().ok_or_else(malformed)?;
+            let verify = request.flags & FLAG_VERIFY_CHILDREN != 0;
+            let mut children = Vec::with_capacity(count);
+            for (index, (claims, proof)) in encoded.into_iter().enumerate() {
+                children.push(child(proof, claims, index, verify)?);
+            }
+            prove(&children, vec![], None, log_inv_rate)
+        }
+        OP_VERIFY => {
+            let claims = reader.claims().ok_or_else(malformed)?;
+            let proof = reader.proof().ok_or_else(malformed)?;
+            reader.end().ok_or_else(malformed)?;
+            child(proof, claims, 0, true)?;
+            Ok(Vec::new())
+        }
+        OP_VERIFY_NARROW => {
+            let claims = reader.claims().ok_or_else(malformed)?;
+            let proof = reader.proof().ok_or_else(malformed)?;
+            let retained = reader.claims().ok_or_else(malformed)?;
+            reader.end().ok_or_else(malformed)?;
+            let verified = child(proof, claims, 0, true)?;
+            prove(&[verified], vec![], Some(&retained), log_inv_rate)
+        }
+        _ => Err(Failure::bad_request("unknown op")),
+    }
+}
diff --git a/bins/leanvm-sidecar/src/shm.rs b/bins/leanvm-sidecar/src/shm.rs
new file mode 100644
index 000000000..8c70b1d4d
--- /dev/null
+++ b/bins/leanvm-sidecar/src/shm.rs
@@ -0,0 +1,225 @@
+//! The channel file: header, two SPSC rings, arena. All of the crate's `unsafe`.
+//!
+//! The peer is another process writing the same pages. Nothing read from the mapping is trusted:
+//! ring counters only select a slot inside the ring, and arena regions are bounds-checked and
+//! copied out before any decoding.
+
+use crate::wire::MSG_SIZE;
+use leanvm::lean_xmss::{MESSAGE_LEN, PUB_KEY_SIZE, SIG_SIZE};
+use std::fs::OpenOptions;
+use std::io;
+use std::os::fd::AsRawFd;
+use std::path::Path;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::time::Duration;
+
+const MAGIC: u64 = u64::from_le_bytes(*b"LEANVMSH");
+const VERSION: u64 = 1;
+const PAGE: usize = 4096;
+
+// Header: u64 words at these offsets. `H_EPOCH` is the only one written after creation.
+const H_MAGIC: usize = 0;
+const H_VERSION: usize = 8;
+const H_EPOCH: usize = 16;
+const H_RING_CAP: usize = 24;
+const H_TOTAL: usize = 32;
+const H_REQ_RING: usize = 40;
+const H_RESP_RING: usize = 48;
+const H_ARENA_OFF: usize = 56;
+const H_ARENA_LEN: usize = 64;
+const H_PUB_KEY_SIZE: usize = 72;
+const H_MESSAGE_LEN: usize = 80;
+const H_SIG_SIZE: usize = 88;
+
+// Ring: consumer and producer counters on separate cache lines, then the slots.
+const R_HEAD: usize = 0;
+const R_TAIL: usize = 64;
+const R_SLOTS: usize = 128;
+
+/// Fault the whole file in at `mmap`: tmpfs allocates its pages then, not under the first requests.
+#[cfg(target_os = "linux")]
+const POPULATE: libc::c_int = libc::MAP_POPULATE;
+#[cfg(not(target_os = "linux"))]
+const POPULATE: libc::c_int = 0;
+
+/// Wait between polls of a full ring.
+const FULL_POLL: Duration = Duration::from_micros(100);
+
+#[derive(Clone, Copy)]
+pub enum Ring {
+    /// Client produces, server consumes.
+    Request,
+    /// Server produces, client consumes.
+    Response,
+}
+
+pub struct Channel {
+    base: *mut u8,
+    total: usize,
+    ring_cap: u64,
+    req_ring: usize,
+    resp_ring: usize,
+    arena_off: usize,
+}
+
+impl Channel {
+    /// Map the channel at `path`, creating it if needed, and start a new epoch.
+    ///
+    /// A file whose header already describes this geometry keeps its rings, so requests queued
+    /// across a restart are served. Any other file is reinitialized; a client still mapping the
+    /// old geometry has to reopen.
+    pub fn create(path: &Path, ring_cap: u32, arena_len: usize) -> io::Result<Self> {
+        if !ring_cap.is_power_of_two() {
+            return Err(io::Error::new(io::ErrorKind::InvalidInput, "ring capacity is not a power of two"));
+        }
+        let ring_bytes = (R_SLOTS + ring_cap as usize * MSG_SIZE).next_multiple_of(PAGE);
+        let (req_ring, resp_ring) = (PAGE, PAGE + ring_bytes);
+        let arena_off = resp_ring + ring_bytes;
+        let total = arena_off + arena_len;
+
+        // A new channel is built under a staging name and renamed into place below, so a client
+        // that finds `path` finds its header written and its pages faulted in.
+        let mut staging = path.as_os_str().to_owned();
+        staging.push(".init");
+        let fresh = !path.exists();
+        let open_at = if fresh { Path::new(&staging) } else { path };
+        let file = OpenOptions::new().read(true).write(true).create(true).truncate(false).open(open_at)?;
+        if file.metadata()?.len() != total as u64 {
+            file.set_len(total as u64)?;
+        }
+        // SAFETY: a new shared mapping of `total` bytes of a file of that length, unmapped in `drop`.
+        let base = unsafe {
+            libc::mmap(
+                std::ptr::null_mut(),
+                total,
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_SHARED | POPULATE,
+                file.as_raw_fd(),
+                0,
+            )
+        };
+        if base == libc::MAP_FAILED {
+            return Err(io::Error::last_os_error());
+        }
+        let chan = Self {
+            base: base.cast(),
+            total,
+            ring_cap: u64::from(ring_cap),
+            req_ring,
+            resp_ring,
+            arena_off,
+        };
+
+        let header = [
+            (H_MAGIC, MAGIC),
+            (H_VERSION, VERSION),
+            (H_RING_CAP, chan.ring_cap),
+            (H_TOTAL, total as u64),
+            (H_REQ_RING, req_ring as u64),
+            (H_RESP_RING, resp_ring as u64),
+            (H_ARENA_OFF, arena_off as u64),
+            (H_ARENA_LEN, arena_len as u64),
+            (H_PUB_KEY_SIZE, PUB_KEY_SIZE as u64),
+            (H_MESSAGE_LEN, MESSAGE_LEN as u64),
+            (H_SIG_SIZE, SIG_SIZE as u64),
+        ];
+        let epoch = chan.word(H_EPOCH).load(Ordering::Relaxed);
+        if !header.iter().all(|&(at, value)| chan.word(at).load(Ordering::Relaxed) == value) {
+            // SAFETY: `[0, arena_off)` is inside the mapping.
+            unsafe { std::ptr::write_bytes(chan.base, 0, arena_off) };
+            for (at, value) in header {
+                chan.word(at).store(value, Ordering::Relaxed);
+            }
+        }
+        // Survives reinitialization, so a client never sees an epoch repeat.
+        chan.word(H_EPOCH).store(epoch.wrapping_add(1), Ordering::Release);
+        if fresh {
+            std::fs::rename(&staging, path)?;
+        }
+        Ok(chan)
+    }
+
+    fn word(&self, at: usize) -> &AtomicU64 {
+        assert!(at.is_multiple_of(8) && at + 8 <= self.total);
+        // SAFETY: in bounds and 8-aligned (the mapping is page-aligned). An `AtomicU64` is valid
+        // for any bit pattern and for concurrent writes by the peer.
+        unsafe { &*self.base.add(at).cast::<AtomicU64>() }
+    }
+
+    fn ring(&self, ring: Ring) -> usize {
+        match ring {
+            Ring::Request => self.req_ring,
+            Ring::Response => self.resp_ring,
+        }
+    }
+
+    fn slot(&self, ring: usize, index: u64) -> *mut u8 {
+        let slot = (index & (self.ring_cap - 1)) as usize;
+        // SAFETY: `slot < ring_cap`, and each ring spans `R_SLOTS + ring_cap * MSG_SIZE` bytes of the mapping.
+        unsafe { self.base.add(ring + R_SLOTS + slot * MSG_SIZE) }
+    }
+
+    /// The oldest unconsumed message of `ring`. Only its one consumer may call this.
+    pub fn pop(&self, ring: Ring) -> Option<[u8; MSG_SIZE]> {
+        let ring = self.ring(ring);
+        let head = self.word(ring + R_HEAD).load(Ordering::Relaxed);
+        if self.word(ring + R_TAIL).load(Ordering::Acquire) == head {
+            return None;
+        }
+        let mut msg = [0; MSG_SIZE];
+        // SAFETY: the slot is `MSG_SIZE` bytes inside the mapping. The producer published it with
+        // its Release store of the tail; a producer that breaks the protocol only garbles the bytes.
+        unsafe { std::ptr::copy_nonoverlapping(self.slot(ring, head), msg.as_mut_ptr(), MSG_SIZE) };
+        self.word(ring + R_HEAD).store(head.wrapping_add(1), Ordering::Release);
+        Some(msg)
+    }
+
+    /// Append `msg` to `ring`, waiting while it is full. Only its one producer may call this.
+    pub fn push(&self, ring: Ring, msg: &[u8; MSG_SIZE]) {
+        let ring = self.ring(ring);
+        let tail = self.word(ring + R_TAIL).load(Ordering::Relaxed);
+        while tail.wrapping_sub(self.word(ring + R_HEAD).load(Ordering::Acquire)) >= self.ring_cap {
+            std::thread::sleep(FULL_POLL);
+        }
+        // SAFETY: as in `pop`; the consumer does not read this slot before the tail moves past it.
+        unsafe { std::ptr::copy_nonoverlapping(msg.as_ptr(), self.slot(ring, tail), MSG_SIZE) };
+        self.word(ring + R_TAIL).store(tail.wrapping_add(1), Ordering::Release);
+    }
+
+    /// `[off, off + len)` as indices into the mapping, if it lies inside the arena. `off` is from the file's start.
+    fn region(&self, off: u64, len: u64) -> Option<(usize, usize)> {
+        let end = off.checked_add(len)?;
+        (off >= self.arena_off as u64 && end <= self.total as u64).then_some((off as usize, len as usize))
+    }
+
+    pub fn in_arena(&self, off: u64, len: u64) -> bool {
+        self.region(off, len).is_some()
+    }
+
+    /// A private copy of an arena region. The peer can still write to the arena, so nothing is decoded in place.
+    pub fn read(&self, off: u64, len: u64) -> Option<Vec<u8>> {
+        let (off, len) = self.region(off, len)?;
+        let mut out = Vec::with_capacity(len);
+        // SAFETY: the source is inside the mapping and `out` has capacity `len`. A concurrent write
+        // by the peer yields arbitrary bytes, which the decoders treat as any other input.
+        unsafe {
+            std::ptr::copy_nonoverlapping(self.base.add(off), out.as_mut_ptr(), len);
+            out.set_len(len);
+        }
+        Some(out)
+    }
+
+    /// Copy `bytes` into the arena at `off`. Panics on a region the caller did not check with [`Self::in_arena`].
+    pub fn write(&self, off: u64, bytes: &[u8]) {
+        let (off, len) = self.region(off, bytes.len() as u64).expect("region outside the arena");
+        // SAFETY: the destination is inside the mapping.
+        unsafe { std::ptr::copy_nonoverlapping(bytes.as_ptr(), self.base.add(off), len) };
+    }
+}
+
+impl Drop for Channel {
+    fn drop(&mut self) {
+        // SAFETY: the mapping `create` made; no reference into it outlives `self`.
+        unsafe { libc::munmap(self.base.cast(), self.total) };
+    }
+}
diff --git a/bins/leanvm-sidecar/src/warm.rs b/bins/leanvm-sidecar/src/warm.rs
new file mode 100644
index 000000000..ee0be6dda
--- /dev/null
+++ b/bins/leanvm-sidecar/src/warm.rs
@@ -0,0 +1,40 @@
+//! The untimed pass the benchmarks run before measuring, done once before the first request.
+//!
+//! `leanvm::setup` builds the guest and spawns the pool. What is left to the first proof of a
+//! shape is first-touch page faults on the gigabytes it allocates, which jemalloc then keeps
+//! mapped, and the tables the prover and verifier cache per size and rate. One discarded
+//! aggregation, verification and full-width recursion per rate pays for both.
+
+use leanvm::lean_xmss::{self, LeafIndex, MESSAGE_LEN};
+use leanvm::{MAX_RECURSIONS, aggregate};
+
+/// Prove, verify and recurse over `signatures` fresh signatures at each of `rates`, discarding the
+/// results. `signers` threads sign; they are gone before the first proof.
+pub fn warm_up(signatures: usize, rates: &[usize], signers: usize) {
+    let (secret_key, pub_key) = lean_xmss::key_gen();
+    let secret_key = &secret_key;
+    // One key, a distinct message per leaf index: `signatures` distinct claims.
+    let raw: Vec<_> = std::thread::scope(|scope| {
+        let workers: Vec<_> = (0..signers)
+            .map(|worker| {
+                scope.spawn(move || {
+                    let sign = |index: usize| {
+                        let mut message = [0u8; MESSAGE_LEN];
+                        message[..8].copy_from_slice(&(index as u64).to_le_bytes());
+                        let signature = lean_xmss::sign(secret_key, &message, index as LeafIndex).unwrap();
+                        (pub_key, message, signature)
+                    };
+                    (worker..signatures).step_by(signers).map(sign).collect::<Vec<_>>()
+                })
+            })
+            .collect();
+        workers.into_iter().flat_map(|worker| worker.join().unwrap()).collect()
+    });
+    for &rate in rates {
+        let leaf = aggregate(&[], raw.clone(), vec![], &[], None, rate).expect("warm-up aggregation");
+        leaf.verify().expect("warm-up verification");
+        // The same child in every slot: the recursion's full width, whatever the claims' union.
+        let children = vec![leaf; MAX_RECURSIONS];
+        aggregate(&children, vec![], vec![], &[], None, rate).expect("warm-up recursion");
+    }
+}
diff --git a/bins/leanvm-sidecar/src/wire.rs b/bins/leanvm-sidecar/src/wire.rs
new file mode 100644
index 000000000..4adcdaa51
--- /dev/null
+++ b/bins/leanvm-sidecar/src/wire.rs
@@ -0,0 +1,156 @@
+//! Message and payload encodings: little-endian, fixed offsets. `PROTOCOL.md` is the specification.
+
+use leanvm::lean_xmss::{LeanXmssPublicKey, LeanXmssSignature, MESSAGE_LEN, Message, PUB_KEY_SIZE, SIG_SIZE};
+use leanvm::{EthereumClaims, EthereumProof};
+
+/// Size of a ring slot, request or response.
+pub const MSG_SIZE: usize = 64;
+
+pub const OP_AGGREGATE: u32 = 1;
+pub const OP_RECURSE: u32 = 2;
+pub const OP_VERIFY: u32 = 3;
+pub const OP_VERIFY_NARROW: u32 = 4;
+
+/// `OP_RECURSE`: verify every child natively before proving.
+pub const FLAG_VERIFY_CHILDREN: u32 = 1;
+
+pub const ST_OK: u32 = 0;
+/// A region outside the arena, an unknown op or a payload that does not decode.
+pub const ST_BAD_REQUEST: u32 = 1;
+/// The response does not fit `resp_cap`; `resp_len` is the size needed.
+pub const ST_RESP_TOO_SMALL: u32 = 2;
+/// A proof does not decode or verify against its claims; `detail` is its index in the request.
+pub const ST_INVALID_PROOF: u32 = 3;
+/// `aggregate` refused or failed; `detail` is the `AggregationError` variant.
+pub const ST_AGGREGATION_FAILED: u32 = 4;
+
+const CLAIM_SIZE: usize = PUB_KEY_SIZE + MESSAGE_LEN;
+const TRIPLE_SIZE: usize = CLAIM_SIZE + SIG_SIZE;
+
+pub struct Request {
+    pub id: u64,
+    pub op: u32,
+    pub flags: u32,
+    pub req_off: u64,
+    pub req_len: u64,
+    pub resp_off: u64,
+    pub resp_cap: u64,
+    pub log_inv_rate: u32,
+}
+
+fn u32_at(bytes: &[u8; MSG_SIZE], at: usize) -> u32 {
+    u32::from_le_bytes(bytes[at..at + 4].try_into().unwrap())
+}
+
+fn u64_at(bytes: &[u8; MSG_SIZE], at: usize) -> u64 {
+    u64::from_le_bytes(bytes[at..at + 8].try_into().unwrap())
+}
+
+impl Request {
+    pub fn decode(bytes: &[u8; MSG_SIZE]) -> Self {
+        Self {
+            id: u64_at(bytes, 0),
+            op: u32_at(bytes, 8),
+            flags: u32_at(bytes, 12),
+            req_off: u64_at(bytes, 16),
+            req_len: u64_at(bytes, 24),
+            resp_off: u64_at(bytes, 32),
+            resp_cap: u64_at(bytes, 40),
+            log_inv_rate: u32_at(bytes, 48),
+        }
+    }
+}
+
+pub struct Response {
+    pub id: u64,
+    pub status: u32,
+    pub detail: u32,
+    pub resp_len: u64,
+}
+
+impl Response {
+    pub fn encode(&self) -> [u8; MSG_SIZE] {
+        let mut out = [0; MSG_SIZE];
+        out[0..8].copy_from_slice(&self.id.to_le_bytes());
+        out[8..12].copy_from_slice(&self.status.to_le_bytes());
+        out[12..16].copy_from_slice(&self.detail.to_le_bytes());
+        out[16..24].copy_from_slice(&self.resp_len.to_le_bytes());
+        out
+    }
+}
+
+/// A payload being decoded. Every count is checked against the bytes left before anything is allocated for it.
+pub struct Reader<'a>(pub &'a [u8]);
+
+impl<'a> Reader<'a> {
+    fn bytes(&mut self, len: usize) -> Option<&'a [u8]> {
+        let (head, rest) = self.0.split_at_checked(len)?;
+        self.0 = rest;
+        Some(head)
+    }
+
+    pub fn u32(&mut self) -> Option<u32> {
+        Some(u32::from_le_bytes(self.bytes(4)?.try_into().unwrap()))
+    }
+
+    /// `n u32 | n x (pubkey | message)`
+    pub fn claims(&mut self) -> Option<EthereumClaims> {
+        let count = self.u32()? as usize;
+        let raw = self.bytes(count.checked_mul(CLAIM_SIZE)?)?;
+        let xmss = raw.as_chunks::<CLAIM_SIZE>().0.iter().map(claim).collect();
+        Some(EthereumClaims {
+            xmss,
+            ..EthereumClaims::default()
+        })
+    }
+
+    /// `len u64 | bytes`
+    pub fn proof(&mut self) -> Option<&'a [u8]> {
+        let len = u64::from_le_bytes(self.bytes(8)?.try_into().unwrap());
+        self.bytes(usize::try_from(len).ok()?)
+    }
+
+    /// `n u32 | n x (pubkey | message | signature)`
+    pub fn signatures(&mut self) -> Option<Vec<(LeanXmssPublicKey, Message, LeanXmssSignature)>> {
+        let count = self.u32()? as usize;
+        let raw = self.bytes(count.checked_mul(TRIPLE_SIZE)?)?;
+        let triples = raw.as_chunks::<TRIPLE_SIZE>().0.iter().map(|triple| {
+            let (head, signature) = triple.split_first_chunk::<CLAIM_SIZE>().unwrap();
+            let (pub_key, message) = claim(head);
+            let signature = LeanXmssSignature::from_bytes(signature.try_into().unwrap());
+            (pub_key, message, signature)
+        });
+        Some(triples.collect())
+    }
+
+    /// `Some` if the payload was consumed whole.
+    pub fn end(self) -> Option<()> {
+        self.0.is_empty().then_some(())
+    }
+}
+
+fn claim(bytes: &[u8; CLAIM_SIZE]) -> (LeanXmssPublicKey, Message) {
+    let (pub_key, message) = bytes.split_first_chunk::<PUB_KEY_SIZE>().unwrap();
+    (LeanXmssPublicKey::from_bytes(pub_key), message.try_into().unwrap())
+}
+
+pub fn put_claims(out: &mut Vec<u8>, claims: &EthereumClaims) {
+    out.extend((claims.xmss.len() as u32).to_le_bytes());
+    for (pub_key, message) in &claims.xmss {
+        out.extend(pub_key.to_bytes());
+        out.extend(message);
+    }
+}
+
+pub fn put_proof(out: &mut Vec<u8>, proof: &[u8]) {
+    out.extend((proof.len() as u64).to_le_bytes());
+    out.extend(proof);
+}
+
+/// `proof | claims`: the response to every op that proves.
+pub fn proved(proof: &EthereumProof) -> Vec<u8> {
+    let mut out = Vec::new();
+    put_proof(&mut out, &proof.proof_bytes());
+    put_claims(&mut out, proof.claims());
+    out
+}

+#!/usr/bin/env bash
+# Build the client into dist/: the mmap addon with the C compiler, the TypeScript with tsc.
+# Needs Node's headers (they ship with Node; NODE_INCLUDE overrides where) and `npm install` for tsc.
+set -euo pipefail
+cd "$(dirname "$0")"
+include=${NODE_INCLUDE:-$(node -p "require('path').resolve(process.execPath, '..', '..', 'include', 'node')")}
+[[ -d node_modules ]] || npm install --no-audit --no-fund
+mkdir -p dist
+# An addon's N-API symbols resolve against the node binary when it is loaded.
+if [[ $(uname) == Darwin ]]; then undefined=(-undefined dynamic_lookup); else undefined=(); fi
+${CC:-cc} -O2 -Wall -Wextra -shared -fPIC "${undefined[@]}" -DNODE_GYP_MODULE_NAME=mmap -I"$include" mmap.c -o dist/mmap.node
+npx tsc
diff --git a/bins/leanvm-sidecar/clients/typescript/client.test.ts b/bins/leanvm-sidecar/clients/typescript/client.test.ts
new file mode 100644
index 000000000..ddeff7880
--- /dev/null
+++ b/bins/leanvm-sidecar/clients/typescript/client.test.ts
@@ -0,0 +1,31 @@
+import { strict as assert } from "node:assert";
+import { test } from "node:test";
+import { Block, place } from "./client";
+
+// Random sends and in-order frees: a placed block is inside the arena and overlaps no live one.
+test("blocks never overlap", () => {
+  const arenaLen = 100;
+  let live: Block[] = [];
+  let state = 1n;
+  let placed = 0;
+  for (let id = 0n; id < 10000n; id++) {
+    state = (state * 6364136223846793005n + 1442695040888963407n) & ((1n << 64n) - 1n);
+    const len = Number((state >> 33n) % 40n);
+    const off = place(live, arenaLen, len);
+    if (off !== null) {
+      assert.ok(off + len <= arenaLen);
+      for (const b of live) {
+        const bEnd = b.off + b.payloadLen + b.respCap;
+        assert.ok(off + len <= b.off || bEnd <= off);
+      }
+      live.push({ id, off, payloadLen: len, respCap: 0 });
+      placed++;
+    } else {
+      live = live.slice(1);
+    }
+    if (state >> 63n === 1n) {
+      live = live.slice(1);
+    }
+  }
+  assert.ok(placed > 1000);
+});
diff --git a/bins/leanvm-sidecar/clients/typescript/client.ts b/bins/leanvm-sidecar/clients/typescript/client.ts
new file mode 100644
index 000000000..50aa08813
--- /dev/null
+++ b/bins/leanvm-sidecar/clients/typescript/client.ts
@@ -0,0 +1,253 @@
+// Client of the leanvm-sidecar service: send a request, tryRecv its response.
+//
+// Payloads and response bodies are raw bytes in the encodings of PROTOCOL.md. It mirrors the Rust
+// client in crates/leanvm_sidecar_client. Node has no mmap, so the mapping comes from the small
+// addon in mmap.c; everything else is here.
+//
+// One Client per channel. Open it while no request of an earlier client is outstanding: the server
+// would write that request's response into arena space this client hands out again.
+//
+// Little-endian hosts only: the ring counters are read as native words.
+
+import { join } from "node:path";
+
+// eslint-disable-next-line @typescript-eslint/no-var-requires
+const native: { map(path: string): ArrayBuffer } = require(join(__dirname, "mmap.node"));
+
+export const OP_AGGREGATE = 1;
+export const OP_RECURSE = 2;
+export const OP_VERIFY = 3;
+export const OP_VERIFY_NARROW = 4;
+
+/** OP_RECURSE: verify every child natively before proving. */
+export const FLAG_VERIFY_CHILDREN = 1;
+
+export const ST_OK = 0;
+export const ST_BAD_REQUEST = 1;
+export const ST_RESP_TOO_SMALL = 2;
+export const ST_INVALID_PROOF = 3;
+export const ST_AGGREGATION_FAILED = 4;
+
+const MAGIC = 0x48534d564e41454cn; // "LEANVMSH"
+const VERSION = 1n;
+const MSG_SIZE = 64;
+
+const H_MAGIC = 0;
+const H_VERSION = 8;
+const H_EPOCH = 16;
+const H_RING_CAP = 24;
+const H_TOTAL = 32;
+const H_REQ_RING = 40;
+const H_RESP_RING = 48;
+const H_ARENA_OFF = 56;
+const H_ARENA_LEN = 64;
+const H_PUB_KEY_SIZE = 72;
+const H_MESSAGE_LEN = 80;
+const H_SIG_SIZE = 88;
+const HEADER_SIZE = 96;
+
+const R_HEAD = 0;
+const R_TAIL = 64;
+const R_SLOTS = 128;
+
+const U64_MASK = (1n << 64n) - 1n;
+
+export interface Response {
+  /** What send returned for the request. */
+  id: bigint;
+  status: number;
+  detail: number;
+  /** The body's length, or under ST_RESP_TOO_SMALL the response capacity the request needed. */
+  respLen: bigint;
+  /** The op's response under ST_OK, UTF-8 text for a human on a failure, empty under ST_RESP_TOO_SMALL. */
+  body: Uint8Array;
+}
+
+/** A request's arena block: its payload, then its response region. Offsets from the arena's start. */
+export interface Block {
+  id: bigint;
+  off: number;
+  payloadLen: number;
+  respCap: number;
+}
+
+const end = (block: Block): number => block.off + block.payloadLen + block.respCap;
+
+/** Where a block of len bytes goes, from the arena's start, given the blocks still held; null if nowhere. */
+export function place(live: readonly Block[], arenaLen: number, len: number): number | null {
+  if (live.length === 0) {
+    return len <= arenaLen ? 0 : null;
+  }
+  const first = live[0];
+  const last = live[live.length - 1];
+  const lastEnd = end(last);
+  if (last.off < first.off) {
+    // Wrapped: the gap up to the oldest block.
+    return len <= first.off - lastEnd ? lastEnd : null;
+  }
+  if (len <= arenaLen - lastEnd) {
+    return lastEnd;
+  }
+  // Wrap into the space before the oldest block. first.off > 0 keeps last.off < first.off meaning wrapped.
+  return first.off > 0 && len <= first.off ? 0 : null;
+}
+
+export class Client {
+  private readonly bytes: Uint8Array;
+  private readonly view: DataView;
+  /** The file as u64 words, for atomic access to the ring counters: word i is at offset 8 * i. */
+  private readonly words: BigUint64Array;
+  private readonly ringCap: bigint;
+  private readonly reqRing: number;
+  private readonly respRing: number;
+  private readonly arenaOff: number;
+  private readonly arenaLen: number;
+  private nextId = 0n;
+  /**
+   * Blocks of requests not yet answered, oldest first. The server answers in order, so the arena is a
+   * circular buffer of them: allocated at the back, freed at the front.
+   */
+  private live: Block[] = [];
+
+  /** Map the channel the server created at path. Responses left by an earlier client are discarded. */
+  static open(path: string): Client {
+    return new Client(native.map(path));
+  }
+
+  private constructor(buffer: ArrayBuffer) {
+    const total = buffer.byteLength;
+    if (total < HEADER_SIZE) {
+      throw new Error("not a leanvm-sidecar channel");
+    }
+    this.bytes = new Uint8Array(buffer);
+    this.view = new DataView(buffer);
+    this.words = new BigUint64Array(buffer, 0, Math.floor(total / 8));
+    const field = (at: number): bigint => this.view.getBigUint64(at, true);
+    const ringCap = field(H_RING_CAP);
+    const arenaOff = field(H_ARENA_OFF);
+    // Every later access is in bounds given these: the rings sit below the arena, the arena inside the file.
+    const ringFits = (ring: bigint): boolean =>
+      ring % 8n === 0n && ring + BigInt(R_SLOTS) + ringCap * BigInt(MSG_SIZE) <= arenaOff;
+    const ok =
+      field(H_MAGIC) === MAGIC &&
+      field(H_VERSION) === VERSION &&
+      field(H_TOTAL) === BigInt(total) &&
+      ringCap > 0n &&
+      ringCap <= BigInt(total) &&
+      (ringCap & (ringCap - 1n)) === 0n &&
+      arenaOff <= BigInt(total) &&
+      field(H_ARENA_LEN) === BigInt(total) - arenaOff &&
+      ringFits(field(H_REQ_RING)) &&
+      ringFits(field(H_RESP_RING));
+    if (!ok) {
+      throw new Error("not a leanvm-sidecar channel of this version");
+    }
+    this.ringCap = ringCap;
+    this.reqRing = Number(field(H_REQ_RING));
+    this.respRing = Number(field(H_RESP_RING));
+    this.arenaOff = Number(arenaOff);
+    this.arenaLen = total - this.arenaOff;
+    this.store(this.respRing + R_HEAD, this.load(this.respRing + R_TAIL));
+  }
+
+  /** Atomic load of the u64 at an 8-aligned offset. */
+  private load(at: number): bigint {
+    return Atomics.load(this.words, at / 8);
+  }
+
+  private store(at: number, value: bigint): void {
+    Atomics.store(this.words, at / 8, value);
+  }
+
+  private slot(ring: number, index: bigint): number {
+    return ring + R_SLOTS + Number(index & (this.ringCap - 1n)) * MSG_SIZE;
+  }
+
+  /** Incremented each time the server starts. A request in flight across a restart gets no response. */
+  epoch(): bigint {
+    return this.load(H_EPOCH);
+  }
+
+  pubKeySize(): number {
+    return Number(this.view.getBigUint64(H_PUB_KEY_SIZE, true));
+  }
+
+  messageLen(): number {
+    return Number(this.view.getBigUint64(H_MESSAGE_LEN, true));
+  }
+
+  sigSize(): number {
+    return Number(this.view.getBigUint64(H_SIG_SIZE, true));
+  }
+
+  /**
+   * Queue a request. respCap bytes of arena are reserved for the response: a proof that does not fit
+   * is discarded by the server (ST_RESP_TOO_SMALL).
+   *
+   * Returns the request's id, or null if the request ring or the arena has no room: receive a
+   * response and retry.
+   */
+  send(op: number, flags: number, logInvRate: number, payload: Uint8Array, respCap: number): bigint | null {
+    const tail = this.load(this.reqRing + R_TAIL);
+    if (((tail - this.load(this.reqRing + R_HEAD)) & U64_MASK) >= this.ringCap) {
+      return null;
+    }
+    if (!Number.isSafeInteger(respCap) || respCap < 0) {
+      return null;
+    }
+    const off = place(this.live, this.arenaLen, payload.length + respCap);
+    if (off === null) {
+      return null;
+    }
+    const id = ++this.nextId;
+    const reqOff = this.arenaOff + off;
+    this.bytes.set(payload, reqOff);
+
+    const msg = this.slot(this.reqRing, tail);
+    this.view.setBigUint64(msg, id, true);
+    this.view.setUint32(msg + 8, op, true);
+    this.view.setUint32(msg + 12, flags, true);
+    this.view.setBigUint64(msg + 16, BigInt(reqOff), true);
+    this.view.setBigUint64(msg + 24, BigInt(payload.length), true);
+    this.view.setBigUint64(msg + 32, BigInt(reqOff + payload.length), true);
+    this.view.setBigUint64(msg + 40, BigInt(respCap), true);
+    this.view.setUint32(msg + 48, logInvRate, true);
+    this.bytes.fill(0, msg + 52, msg + MSG_SIZE);
+    this.store(this.reqRing + R_TAIL, (tail + 1n) & U64_MASK);
+    this.live.push({ id, off, payloadLen: payload.length, respCap });
+    return id;
+  }
+
+  /**
+   * The next response, or null if the server has produced none. Frees the request's arena block, and
+   * those of earlier requests that a server restart left unanswered.
+   */
+  tryRecv(): Response | null {
+    const head = this.load(this.respRing + R_HEAD);
+    if (this.load(this.respRing + R_TAIL) === head) {
+      return null;
+    }
+    const msg = this.slot(this.respRing, head);
+    const response: Response = {
+      id: this.view.getBigUint64(msg, true),
+      status: this.view.getUint32(msg + 8, true),
+      detail: this.view.getUint32(msg + 12, true),
+      respLen: this.view.getBigUint64(msg + 16, true),
+      body: new Uint8Array(0),
+    };
+    this.store(this.respRing + R_HEAD, (head + 1n) & U64_MASK);
+
+    while (this.live.length > 0 && this.live[0].id < response.id) {
+      this.live.shift();
+    }
+    if (this.live.length > 0 && this.live[0].id === response.id) {
+      const block = this.live.shift()!;
+      if (response.status !== ST_RESP_TOO_SMALL && response.respLen <= BigInt(block.respCap)) {
+        const respOff = this.arenaOff + block.off + block.payloadLen;
+        // slice copies: the body outlives the arena block.
+        response.body = this.bytes.slice(respOff, respOff + Number(response.respLen));
+      }
+    }
+    return response;
+  }
+}
diff --git a/bins/leanvm-sidecar/clients/typescript/e2e.ts b/bins/leanvm-sidecar/clients/typescript/e2e.ts
new file mode 100644
index 000000000..bd34b80de
--- /dev/null
+++ b/bins/leanvm-sidecar/clients/typescript/e2e.ts
@@ -0,0 +1,92 @@
+// The run e2e.sh drives: e2e <channel> <signatures-file> <aggregate-rate> <recurse-rate>
+//
+// Sixteen AGGREGATE requests of 1500 signatures each, one after the other, then one RECURSE over
+// the sixteen proofs. The file is records of pubkey | message | signature.
+
+import { readFileSync } from "node:fs";
+import { Client, OP_AGGREGATE, OP_RECURSE, Response, ST_OK } from "./client";
+
+const BATCHES = 16;
+const PER_BATCH = 1500;
+const RESP_CAP = 16 << 20;
+
+const sleeper = new Int32Array(new SharedArrayBuffer(4));
+
+/** Send one request and wait for its response; also the seconds it took. */
+function call(client: Client, op: number, rate: number, payload: Uint8Array): [Response, number] {
+  const started = process.hrtime.bigint();
+  const id = client.send(op, 0, rate, payload, RESP_CAP);
+  if (id === null) {
+    throw new Error("no room in the channel");
+  }
+  for (;;) {
+    const response = client.tryRecv();
+    if (response === null) {
+      // A 100 microsecond sleep; nothing ever notifies.
+      Atomics.wait(sleeper, 0, 0, 0.1);
+      continue;
+    }
+    if (response.id !== id) {
+      throw new Error(`response ${response.id} to request ${id}`);
+    }
+    return [response, Number(process.hrtime.bigint() - started) / 1e9];
+  }
+}
+
+/** A proof | claims body cut into the two, each with its length prefix. */
+function split(response: Response): [Buffer, Buffer] {
+  const body = Buffer.from(response.body.buffer, response.body.byteOffset, response.body.length);
+  if (response.status !== ST_OK) {
+    console.log(`  FAILED: status ${response.status} detail ${response.detail}: ${body.toString("utf8")}`);
+    process.exit(1);
+  }
+  const proofEnd = 8 + Number(body.readBigUInt64LE(0));
+  return [body.subarray(0, proofEnd), body.subarray(proofEnd)];
+}
+
+function u32(value: number): Buffer {
+  const out = Buffer.alloc(4);
+  out.writeUInt32LE(value);
+  return out;
+}
+
+function main(): void {
+  const args = process.argv.slice(2);
+  if (args.length !== 4) {
+    console.error("usage: e2e <channel> <signatures-file> <aggregate-rate> <recurse-rate>");
+    process.exit(2);
+  }
+  const aggregateRate = Number.parseInt(args[2], 10);
+  const recurseRate = Number.parseInt(args[3], 10);
+  const client = Client.open(args[0]);
+  const record = client.pubKeySize() + client.messageLen() + client.sigSize();
+  const signatures = readFileSync(args[1]);
+  if (signatures.length < BATCHES * PER_BATCH * record) {
+    throw new Error("signature file too short");
+  }
+
+  const total = process.hrtime.bigint();
+  const recurse: Buffer[] = [u32(BATCHES)];
+  for (let batch = 0; batch < BATCHES; batch++) {
+    const records = signatures.subarray(batch * PER_BATCH * record, (batch + 1) * PER_BATCH * record);
+    const payload = Buffer.concat([u32(PER_BATCH), records]);
+    const [response, seconds] = call(client, OP_AGGREGATE, aggregateRate, payload);
+    const [proof, claims] = split(response);
+    console.log(
+      `aggregate ${String(batch + 1).padStart(2)}/${BATCHES}: ${PER_BATCH} signatures, ${payload.length} bytes, ` +
+        `rate ${aggregateRate} -> proof ${proof.length - 8} bytes, ${claims.readUInt32LE(0)} claims, ` +
+        `${seconds.toFixed(3)} s`,
+    );
+    recurse.push(claims, proof);
+  }
+  const payload = Buffer.concat(recurse);
+  const [response, seconds] = call(client, OP_RECURSE, recurseRate, payload);
+  const [proof, claims] = split(response);
+  console.log(
+    `recurse ${BATCHES} -> 1: ${BATCHES} proofs, ${payload.length} bytes, rate ${recurseRate} -> ` +
+      `proof ${proof.length - 8} bytes, ${claims.readUInt32LE(0)} claims, ${seconds.toFixed(3)} s`,
+  );
+  console.log(`total: ${(Number(process.hrtime.bigint() - total) / 1e9).toFixed(3)} s`);
+}
+
+main();
diff --git a/bins/leanvm-sidecar/clients/typescript/mmap.c b/bins/leanvm-sidecar/clients/typescript/mmap.c
new file mode 100644
index 000000000..e056f132f
--- /dev/null
+++ b/bins/leanvm-sidecar/clients/typescript/mmap.c
@@ -0,0 +1,72 @@
+// The one thing Node lacks: map(path) returns the whole file as an ArrayBuffer over a shared,
+// writable mapping. The mapping is released when the ArrayBuffer is collected.
+
+#define _GNU_SOURCE
+#include <fcntl.h>
+#include <node_api.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#ifndef MAP_POPULATE
+#define MAP_POPULATE 0
+#endif
+
+static void unmap(napi_env env, void *data, void *hint) {
+    (void)env;
+    munmap(data, (size_t)(uintptr_t)hint);
+}
+
+static napi_value fail(napi_env env, const char *what) {
+    napi_throw_error(env, NULL, what);
+    return NULL;
+}
+
+static napi_value map(napi_env env, napi_callback_info info) {
+    size_t argc = 1;
+    napi_value arg;
+    char path[4096];
+    size_t path_len;
+    if (napi_get_cb_info(env, info, &argc, &arg, NULL, NULL) != napi_ok || argc != 1 ||
+        napi_get_value_string_utf8(env, arg, path, sizeof path, &path_len) != napi_ok || path_len == sizeof path - 1) {
+        return fail(env, "map(path): one string, shorter than 4095 bytes");
+    }
+    int fd = open(path, O_RDWR | O_CLOEXEC);
+    if (fd < 0) {
+        return fail(env, strerror(errno));
+    }
+    struct stat st;
+    if (fstat(fd, &st) != 0 || st.st_size <= 0) {
+        close(fd);
+        return fail(env, "cannot size the file, or it is empty");
+    }
+    size_t len = (size_t)st.st_size;
+    // MAP_POPULATE: no request takes this process's first-touch faults on the arena.
+    void *base = mmap(NULL, len, PROT_READ | PROT_WRITE, MAP_SHARED | MAP_POPULATE, fd, 0);
+    int mmap_errno = errno;
+    close(fd);
+    if (base == MAP_FAILED) {
+        return fail(env, strerror(mmap_errno));
+    }
+    napi_value buffer;
+    if (napi_create_external_arraybuffer(env, base, len, unmap, (void *)(uintptr_t)len, &buffer) != napi_ok) {
+        munmap(base, len);
+        return fail(env, "cannot wrap the mapping in an ArrayBuffer");
+    }
+    return buffer;
+}
+
+static napi_value init(napi_env env, napi_value exports) {
+    napi_value fn;
+    if (napi_create_function(env, "map", NAPI_AUTO_LENGTH, map, NULL, &fn) != napi_ok ||
+        napi_set_named_property(env, exports, "map", fn) != napi_ok) {
+        return fail(env, "cannot export map");
+    }
+    return exports;
+}
+
+NAPI_MODULE(NODE_GYP_MODULE_NAME, init)

+++ b/crates/leanvm_sidecar_client/examples/jumps.rs
@@ -0,0 +1,299 @@
+//! Where the cost of an op jumps, and what a cross-rate EXTEND costs:
+//! jumps <channel> <signatures-a> <signatures-b> <out.csv> <main|perf> [parts]
+//!
+//! `parts` is a comma-separated subset of `aggregate,extend,cross,recurse` (default: all).
+//! `signatures-a` and `signatures-b` are record files whose claims do not overlap each other.
+//! Every point runs once untimed, then 3 times. The CSV has the columns of `costs.rs`. Extra ops:
+//!   EXTEND_X: kept proof at rate 1, EXTEND at the rate in the `rate` column.
+//!   EXTEND_S: kept proof and EXTEND both at the rate in the `rate` column (the same-rate control for EXTEND_X).
+//!   RECURSE_KEPT: one child is a kept root of 16 x 1500 claims (rate 1), `children` fresh 1500-signature children.
+//! Without `perf`, AGGREGATE is measured at step 8 inside the four brackets and refined to step 1 around
+//! the biggest jumps. With `perf` it is one coarse pass at step 16.
+//! A jump is an interval whose cost per signature exceeds 3 times the median of its series.
+
+use leanvm_sidecar_client::{
+    Client, FLAG_KEEP_PROOF, FLAG_USE_KEPT, OP_AGGREGATE, OP_EXTEND, OP_RECURSE, Response, ST_OK,
+};
+use std::collections::HashMap;
+use std::fs::File;
+use std::io::Write;
+use std::time::Instant;
+
+const RESP_CAP: usize = 16 << 20;
+const TIMED: usize = 3;
+const LEAF: usize = 1500;
+const BRACKETS: [(usize, usize); 4] = [(150, 200), (300, 384), (600, 750), (1200, 1500)];
+
+#[derive(Clone)]
+struct Proved {
+    proof: Vec<u8>,
+    claims: Vec<u8>,
+}
+
+impl Proved {
+    fn parse(body: &[u8]) -> Self {
+        let len = u64::from_le_bytes(body[..8].try_into().unwrap()) as usize;
+        let (proof, claims) = body.split_at(8 + len);
+        Self { proof: proof.to_vec(), claims: claims.to_vec() }
+    }
+
+    fn child(&self) -> Vec<u8> {
+        [self.claims.as_slice(), &self.proof].concat()
+    }
+}
+
+#[derive(Clone, Copy, Default)]
+struct Point {
+    rate: u32,
+    n_sigs: usize,
+    children: usize,
+    child_sigs: usize,
+    kept_sigs: usize,
+    new_sigs: usize,
+}
+
+struct Bench {
+    client: Client,
+    a: Vec<u8>,
+    b: Vec<u8>,
+    record: usize,
+    csv: File,
+    /// Median ms of points already measured, by (op, point fields).
+    done: HashMap<String, f64>,
+}
+
+fn call(client: &mut Client, op: u32, flags: u32, rate: u32, payload: &[u8]) -> (Response, f64) {
+    let started = Instant::now();
+    let id = client.send(op, flags, rate, payload, RESP_CAP).expect("no room in the channel");
+    let response = loop {
+        match client.try_recv() {
+            Some(response) => break response,
+            None => std::hint::spin_loop(),
+        }
+    };
+    let ms = started.elapsed().as_secs_f64() * 1e3;
+    assert_eq!(response.id, id);
+    (response, ms)
+}
+
+fn proof_len(body: &[u8]) -> usize {
+    u64::from_le_bytes(body[..8].try_into().unwrap()) as usize
+}
+
+impl Bench {
+    /// `count` signatures from record `first` of file `a` or `b`, as an `AGGREGATE` payload.
+    fn signatures(&self, from_b: bool, first: usize, count: usize) -> Vec<u8> {
+        let file = if from_b { &self.b } else { &self.a };
+        let records = &file[first * self.record..(first + count) * self.record];
+        [(count as u32).to_le_bytes().as_slice(), records].concat()
+    }
+
+    fn leaf(&mut self, from_b: bool, first: usize, count: usize, rate: u32) -> Proved {
+        let payload = self.signatures(from_b, first, count);
+        let (response, _) = call(&mut self.client, OP_AGGREGATE, 0, rate, &payload);
+        assert_eq!(response.status, ST_OK, "{}", String::from_utf8_lossy(&response.body));
+        Proved::parse(&response.body)
+    }
+
+    fn recurse_payload(children: &[&Proved]) -> Vec<u8> {
+        let mut payload = (children.len() as u32).to_le_bytes().to_vec();
+        for child in children {
+            payload.extend(child.child());
+        }
+        payload
+    }
+
+    fn row(&mut self, op: &str, p: Point, run: usize, ms: Option<f64>, bytes: usize) {
+        let ms = ms.map_or("FAIL".to_string(), |ms| format!("{ms:.3}"));
+        let line = format!(
+            "{op},{},{},{},{},{},{},0,{run},{ms},{bytes}\n",
+            p.rate, p.n_sigs, p.children, p.child_sigs, p.kept_sigs, p.new_sigs
+        );
+        self.csv.write_all(line.as_bytes()).unwrap();
+        self.csv.flush().unwrap();
+    }
+
+    /// Median ms of the point; 1 discarded run, then `TIMED`. `request` may do untimed setup. None on failure.
+    fn measure(&mut self, op: &str, p: Point, mut request: impl FnMut(&mut Client) -> (Response, f64)) -> Option<f64> {
+        let key = format!("{op},{},{},{},{},{},{}", p.rate, p.n_sigs, p.children, p.child_sigs, p.kept_sigs, p.new_sigs);
+        if let Some(ms) = self.done.get(&key) {
+            return Some(*ms);
+        }
+        let (first, _) = request(&mut self.client);
+        if first.status != ST_OK {
+            println!("{key}: FAILED status {} detail {}: {}", first.status, first.detail, String::from_utf8_lossy(&first.body));
+            self.row(op, p, 1, None, 0);
+            return None;
+        }
+        let mut times = Vec::new();
+        for run in 1..=TIMED {
+            let (response, ms) = request(&mut self.client);
+            if response.status != ST_OK {
+                println!("{key}: FAILED in run {run}");
+                self.row(op, p, run, None, 0);
+                return None;
+            }
+            let bytes = proof_len(&response.body);
+            self.row(op, p, run, Some(ms), bytes);
+            times.push(ms);
+        }
+        times.sort_by(f64::total_cmp);
+        let median = times[TIMED / 2];
+        println!("{key}: median {median:.1} ms, min {:.1}", times[0]);
+        self.done.insert(key, median);
+        Some(median)
+    }
+
+    fn aggregate_at(&mut self, n: usize, rate: u32) -> Option<f64> {
+        let payload = self.signatures(false, 0, n);
+        let p = Point { rate, n_sigs: n, ..Point::default() };
+        self.measure("AGGREGATE", p, |c| call(c, OP_AGGREGATE, 0, rate, &payload))
+    }
+
+    /// EXTEND of a kept proof of `k` signatures (made at `kept_rate`) with `n` new ones at `rate`.
+    fn extend_at(&mut self, op: &str, k: usize, n: usize, kept_rate: u32, rate: u32) -> Option<f64> {
+        let kept_payload = self.signatures(false, 0, k);
+        let mut payload = 0u32.to_le_bytes().to_vec();
+        payload.extend(self.signatures(false, k, n));
+        let p = Point { rate, kept_sigs: k, new_sigs: n, ..Point::default() };
+        self.measure(op, p, |c| {
+            let (kept, _) = call(c, OP_AGGREGATE, FLAG_KEEP_PROOF, kept_rate, &kept_payload);
+            assert_eq!(kept.status, ST_OK);
+            call(c, OP_EXTEND, FLAG_USE_KEPT, rate, &payload)
+        })
+    }
+
+    /// Refine, to step 1, the intervals of `series` (sorted by size) whose cost per signature exceeds
+    /// 3 times the series' median, at most `limit` of them, by calling `at` on each size inside.
+    fn refine(&mut self, series: &[(usize, f64)], limit: usize, at: &mut dyn FnMut(&mut Self, usize)) {
+        let mut slopes: Vec<(f64, usize)> = series
+            .windows(2)
+            .enumerate()
+            .map(|(i, w)| ((w[1].1 - w[0].1) / (w[1].0 - w[0].0) as f64, i))
+            .collect();
+        let mut sorted: Vec<f64> = slopes.iter().map(|s| s.0).collect();
+        sorted.sort_by(f64::total_cmp);
+        let median = sorted[sorted.len() / 2].max(0.01);
+        slopes.sort_by(|x, y| y.0.total_cmp(&x.0));
+        for (slope, i) in slopes.into_iter().take(limit) {
+            if slope <= 3.0 * median {
+                break;
+            }
+            let (lo, hi) = (series[i].0, series[i + 1].0);
+            println!("refine ({lo}, {hi}]: {slope:.2} ms per signature, median {median:.2}");
+            for n in lo + 1..hi {
+                at(self, n);
+            }
+        }
+    }
+
+    fn aggregate(&mut self, perf: bool) {
+        for rate in [1, 2] {
+            if perf {
+                let mut sizes: Vec<usize> = std::iter::once(1).chain((1..=93).map(|i| i * 16)).collect();
+                sizes.push(1500);
+                for n in sizes {
+                    self.aggregate_at(n, rate);
+                }
+                continue;
+            }
+            for (lo, hi) in BRACKETS {
+                let mut sizes: Vec<usize> = (lo..hi).step_by(8).collect();
+                sizes.push(hi);
+                let mut series = Vec::new();
+                for n in sizes {
+                    if let Some(ms) = self.aggregate_at(n, rate) {
+                        series.push((n, ms));
+                    }
+                }
+                self.refine(&series, 2, &mut |b, n| {
+                    b.aggregate_at(n, rate);
+                });
+            }
+        }
+    }
+
+    /// New-signature counts `first, first + step, ...` up to `last`, and `last` itself if not reached.
+    fn sizes(first: usize, step: usize, last: usize) -> Vec<usize> {
+        let mut sizes: Vec<usize> = (first..=last).step_by(step).collect();
+        if *sizes.last().unwrap() != last {
+            sizes.push(last);
+        }
+        sizes
+    }
+
+    fn extend(&mut self) {
+        for (k, step, last) in [(300, 16, 1200), (1350, 8, 150)] {
+            for rate in [1, 2] {
+                let mut series = Vec::new();
+                for n in Self::sizes(1, step, last) {
+                    if let Some(ms) = self.extend_at("EXTEND", k, n, rate, rate) {
+                        series.push((n, ms));
+                    }
+                }
+                self.refine(&series, 3, &mut |b, n| {
+                    b.extend_at("EXTEND", k, n, rate, rate);
+                });
+            }
+        }
+    }
+
+    fn cross(&mut self) {
+        for k in [300, 1350] {
+            for n in [1, 150, 300, 750] {
+                self.extend_at("EXTEND_X", k, n, 1, 2);
+                self.extend_at("EXTEND_S", k, n, 2, 2);
+            }
+        }
+    }
+
+    fn recurse(&mut self) {
+        let leaves_a: Vec<Proved> = (0..16).map(|i| self.leaf(false, i * LEAF, LEAF, 2)).collect();
+        for rate in [1, 2] {
+            for c in 1..=16 {
+                let payload = Self::recurse_payload(&leaves_a[..c].iter().collect::<Vec<_>>());
+                let p = Point { rate, children: c, child_sigs: LEAF, ..Point::default() };
+                self.measure("RECURSE", p, |cl| call(cl, OP_RECURSE, 0, rate, &payload));
+            }
+        }
+        let leaves_b: Vec<Proved> = (0..15).map(|i| self.leaf(true, i * LEAF, LEAF, 2)).collect();
+        let root_payload = Self::recurse_payload(&leaves_a.iter().collect::<Vec<_>>());
+        for c in 1..=15 {
+            let payload = Self::recurse_payload(&leaves_b[..c].iter().collect::<Vec<_>>());
+            let p = Point { rate: 1, children: c, child_sigs: LEAF, kept_sigs: 16 * LEAF, ..Point::default() };
+            self.measure("RECURSE_KEPT", p, |cl| {
+                // The kept root is consumed by each request: rebuild it, untimed.
+                let (root, _) = call(cl, OP_RECURSE, FLAG_KEEP_PROOF, 1, &root_payload);
+                assert_eq!(root.status, ST_OK);
+                call(cl, OP_RECURSE, FLAG_USE_KEPT, 1, &payload)
+            });
+        }
+    }
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    if args.len() < 6 {
+        eprintln!("usage: jumps <channel> <signatures-a> <signatures-b> <out.csv> <main|perf> [parts]");
+        std::process::exit(2);
+    }
+    let perf = args[5] == "perf";
+    let parts = args.get(6).map_or("aggregate,extend,cross,recurse", String::as_str).to_string();
+    let client = Client::open(args[1].as_ref()).expect("open channel");
+    let record = client.pub_key_size() + client.message_len() + client.sig_size();
+    let a = std::fs::read(&args[2]).expect("read signatures a");
+    let b = std::fs::read(&args[3]).expect("read signatures b");
+    assert!(a.len() >= 24000 * record && b.len() >= 22500 * record, "signature files too short");
+    let mut csv = File::create(&args[4]).expect("create csv");
+    csv.write_all(b"op,rate,n_sigs,children,child_sigs,kept_sigs,new_sigs,verify_children,run,ms,proof_bytes\n").unwrap();
+    let mut bench = Bench { client, a, b, record, csv, done: HashMap::new() };
+    for part in parts.split(',') {
+        match part {
+            "aggregate" => bench.aggregate(perf),
+            "extend" => bench.extend(),
+            "cross" => bench.cross(),
+            "recurse" => bench.recurse(),
+            other => panic!("unknown part {other}"),
+        }
+    }
+}
